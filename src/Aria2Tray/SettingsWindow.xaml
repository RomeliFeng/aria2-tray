<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Aria2Tray.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="24,20,24,20" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Style="{StaticResource SubtitleTextBlockStyle}" />
        <ScrollViewer Grid.Row="1" Margin="0,0,-12,0" Padding="0,0,12,0">
            <StackPanel Spacing="16">
                <TextBox x:Name="UrlBox" PlaceholderText="http://192.168.1.10:6800/jsonrpc" IsSpellCheckEnabled="False" />
                <PasswordBox x:Name="SecretBox" />
                <StackPanel Spacing="8">
                    <TextBlock x:Name="LocationTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBox x:Name="LocalDirBox" PlaceholderText="\\nas\Download" IsSpellCheckEnabled="False" />
                    <TextBox x:Name="RemoteDirBox" IsSpellCheckEnabled="False" />
                </StackPanel>
                <ComboBox x:Name="LanguageBox" MinWidth="200" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <NumberBox x:Name="WidthBox" Minimum="300" Maximum="1200" SmallChange="20" SpinButtonPlacementMode="Inline" MinWidth="150" />
                    <NumberBox x:Name="HeightBox" Minimum="300" Maximum="1600" SmallChange="20" SpinButtonPlacementMode="Inline" MinWidth="150" />
                </StackPanel>
                <ToggleSwitch x:Name="NotifySwitch" />
                <ToggleSwitch x:Name="StartupSwitch" />
            </StackPanel>
        </ScrollViewer>
        <TextBlock x:Name="ErrorText" Grid.Row="2" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <ProgressRing x:Name="Busy" Width="20" Height="20" IsActive="False" />
            <Button x:Name="SaveButton" Style="{StaticResource AccentButtonStyle}" MinWidth="96" Click="SaveButton_Click" />
            <Button x:Name="CancelButton" MinWidth="96" Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</Window>
